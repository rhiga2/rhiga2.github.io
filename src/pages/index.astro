---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Ryley Higa" description="Senior machine learning engineer.">
  <section class="relative overflow-hidden rounded-2xl my-8">
    <div class="absolute inset-0 bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 animate-gradient"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_40%,rgba(255,255,255,0.15),transparent_60%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_70%,rgba(255,255,255,0.1),transparent_50%)]"></div>
    <div class="relative z-10 px-8 py-20 md:py-28">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-white drop-shadow-sm">
        Hi, I'm Ryley
      </h1>
      <p class="text-lg md:text-xl text-white/85 mb-8 max-w-xl">
        Senior machine learning engineer in Honolulu, HI. I build reliable
        systems from unreliable AI.
      </p>
      <div class="flex gap-3">
        <a
          href="/resume/"
          class="bg-white text-gray-900 px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-white/90 transition-colors shadow-sm"
        >
          View Resume →
        </a>
        <a
          href="/blog/"
          class="border border-white/40 text-white px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-white/10 transition-colors backdrop-blur-sm"
        >
          Read Blog
        </a>
      </div>
    </div>
  </section>

  <section class="py-8 border-t border-gray-200">
    <h2 class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">
      Recent posts
    </h2>
    <ul class="flex flex-col gap-6">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="block group">
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="font-bold text-gray-900 group-hover:underline">
                  {post.data.title}
                </h3>
                <time class="text-xs text-gray-400 whitespace-nowrap">
                  {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
              </div>
              <p class="text-sm text-gray-500 mt-1">{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  @keyframes gradient-shift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  .animate-gradient {
    background-size: 200% 200%;
    animation: gradient-shift 8s ease infinite;
  }
</style>
